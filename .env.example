DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/testnow
REDIS_URL=redis://HOST:6379/0
# Opt-in scale-to-zero workers. Apply migration 0022 and follow the cutover
# instructions in infrastructure/railway-scale-to-zero.md before enabling.
DURABLE_JOBS_ENABLED=false
WORKER_WAKE_TOKEN=
WORKER_WAKE_URL=http://worker.railway.internal:8000
EXPLAINER_WORKER_WAKE_URL=http://explainer-worker.railway.internal:8000
# Set to explainers only on the dedicated render worker.
WORKER_QUEUE=celery
WORKER_MAX_ATTEMPTS=3
WORKER_JOB_TIMEOUT_SECONDS=3600
S3_ENDPOINT_URL=https://storage.railway.app
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=testnow
S3_REGION=auto
SESSION_SECRET=generate-a-long-random-secret
COOKIE_SECURE=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_SECONDS=90
EXPLAINER_MODEL=google/gemini-3.1-flash-lite
EXPLAINER_TTS_MODEL=mistralai/voxtral-mini-tts-3-0
EXPLAINER_TTS_VOICE=voice_3153
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=60
MAX_RENDERED_PDF_BYTES=20000000
NEXT_PUBLIC_APP_NAME=TestNow
API_INTERNAL_URL=http://api.railway.internal:8000
# Development only. Never enable this in a shared or production environment.
SEED_DEMO_DATA=false
